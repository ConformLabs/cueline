<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ExtensionBundleId="com.conformlabs.cueline" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Cueline" Version="11.0">
  <ExtensionList>
    <Extension Id="com.conformlabs.cueline.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="11.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.conformlabs.cueline.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Cueline</Menu>
          <Geometry>
            <Size><Height>720</Height><Width>340</Width></Size>
            <MinSize><Height>420</Height><Width>280</Width></MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/panel-icon.png</Icon>
            <Icon Type="RollOver">./img/panel-icon.png</Icon>
            <Icon Type="DarkNormal">./img/panel-icon.png</Icon>
            <Icon Type="DarkRollOver">./img/panel-icon.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
